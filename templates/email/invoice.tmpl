<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{.Subject}}</title>
</head>
<body style="margin: 0; padding: 20px 12px; background-color: #f3f4f6">
    <table role="presentation" width="100%" border="0" cellspacing="0" cellpadding="0">
        <tr>
            <td align="center">
                <table role="presentation" width="100%" border="0" cellspacing="0" cellpadding="0" style="max-width: 600px; border-collapse: collapse; background-color: #ffffff">
                    <tr>
                        <td style="padding: 28px; font-family: Arial, Helvetica, sans-serif; font-size: 15px; line-height: 1.6; color: #111827">{{.Body}}</td>
                    </tr>
                </table>
            </td>
        </tr>
    </table>
</body>
</html>
